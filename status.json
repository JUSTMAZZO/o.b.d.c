{
  "project": {
    "name": "o.b.d.c",
    "tagline": "Recompilação estática AArch64 → AArch64: binários de Nintendo Switch rodando nativamente no Android",
    "updated": "2026-10-14",
    "license": "MIT",
    "repo": "https://github.com/JUSTMAZZO/o.b.d.c",
    "vision": {
      "endgame": "Tradução e recompilação estática AArch64-to-AArch64 (Switch ELF/NSO → Android Bionic ELF)",
      "source": "Nintendo Switch — AArch64, Horizon OS, homebrew via libnx (ELF/NRO/NSO)",
      "target": "Samsung Galaxy A56 — Exynos 1580 (s5e8855), GPU Xclipse 540 (Vulkan), Android / Bionic, AArch64",
      "rationale": "Origem e destino compartilham o mesmo ISA (ARMv8-A AArch64). Não há emulação de CPU: o código de máquina é elevado, entendido e reemitido como ELF Android nativo. O trabalho real está na tradução de ABI, syscalls (svc), memória e subsistemas (áudio, threads, GPU)."
    },
    "scope_note": "Projeto de engenharia de compiladores e tradução de ABI. O foco são homebrews e ELFs próprios/de código aberto; não distribui nem ajuda a obter firmware, chaves ou jogos comerciais."
  },
